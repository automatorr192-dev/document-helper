# Скопировать в .env и заполнить. .env в git не попадает — проверь .gitignore.

TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=

# Через запятую, по порядку. Первая недоступна — берётся следующая.
# MODELS — разбор договора, MODELS_LIGHT — проверка брифа и распознавание сканов:
# переписать текст с картинки проще, чем его анализировать, и намного дешевле.
MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-super-120b-a12b:free,deepseek/deepseek-v4-flash
MODELS_LIGHT=nvidia/nemotron-3.5-super-vl:free,anthropic/claude-haiku-4.5

# Распознавание скана: сколько страниц смотрим и с каким качеством. Каждая страница —
# отдельный платный запрос, поэтому потолок обязателен.
OCR_MAX_PAGES=5
OCR_DPI=150

# Адрес мини-аппа. Локально — https-туннель, в облаке — домен приложения.
WEBAPP_URL=

# Адрес приложения снаружи: из него собирается ссылка на отчёт, которой делятся.
# На Render пусто — он подставляет RENDER_EXTERNAL_URL сам.
PUBLIC_URL=

# Задан вместе с адресом — бот на вебхуке (облако, где приложение засыпает). Пусто — long polling.
WEBHOOK_SECRET=

# Сколько дней живёт ссылка на отчёт.
SHARE_TTL_DAYS=30

# Абсолютный путь. В облаке это persistent volume, всё остальное умирает при передеплое.
DATA_DIR=/data

# Пусто — Sentry выключен целиком, ошибки остаются только в логах.
SENTRY_DSN=
SENTRY_ENV=prod

# Своя модель вместо OpenRouter: любой OpenAI-совместимый адрес (vLLM, Ollama и т.п.)
# и ключ к нему. Пусто — OpenRouter с OPENROUTER_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=

# Бот в MAX (dev.max.ru, только самозанятым, ИП и юрлицам). Пусто — MAX выключен.
MAX_BOT_TOKEN=
